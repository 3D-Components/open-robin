<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robin_telemetry</name>
  <version>0.0.1</version>
  <description>Telemetry aggregator: combines recorded raw welding topics
    (fronius + geometry) into ProcessTelemetry on /robin/telemetry for the
    ROS-bag replay demo (real data -> DDS -> FIWARE -> dashboard).</description>
  <maintainer email="daniel.haas@3d-components.co">Daniel Haas</maintainer>
  <maintainer email="virgilio.gomez@3d-components.co">Virgilio Gomez</maintainer>
  <maintainer email="jayant@mil-as.no">Jayant Singh</maintainer>
  <license>AGPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>robin_interfaces</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
