<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="welding_cell">
    <!-- Physics -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- System plugins (explicit list required once any <plugin> is added) -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Welding plates (300×300×6 mm steel) ─────────────────────── -->
    <!-- Positions from plates.json calibration data (base_link frame)  -->

    <!-- plate_03 / plate_01 position (front table area) -->
    <model name="weld_plate_front">
      <static>true</static>
      <pose>-1.3751 -0.5063 -0.1877 0 0 0</pose>
      <link name="plate_link">
        <collision name="col">
          <geometry><box><size>0.3 0.3 0.006</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.006</size></box></geometry>
          <material>
            <ambient>0.30 0.28 0.25 1</ambient>
            <diffuse>0.45 0.43 0.40 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- plate_04 / plate_02 position (rear table area) -->
    <model name="weld_plate_rear">
      <static>true</static>
      <pose>-0.9852 -0.4962 -0.1958 0 0 0</pose>
      <link name="plate_link">
        <collision name="col">
          <geometry><box><size>0.3 0.3 0.006</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.006</size></box></geometry>
          <material>
            <ambient>0.30 0.28 0.25 1</ambient>
            <diffuse>0.45 0.43 0.40 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- test_plate_01 position (opposite side of table, yaw 180°) -->
    <model name="weld_plate_test">
      <static>true</static>
      <pose>-1.1831 0.4714 -0.1772 0 0 3.14159</pose>
      <link name="plate_link">
        <collision name="col">
          <geometry><box><size>0.3 0.3 0.006</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.006</size></box></geometry>
          <material>
            <ambient>0.30 0.28 0.25 1</ambient>
            <diffuse>0.45 0.43 0.40 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>