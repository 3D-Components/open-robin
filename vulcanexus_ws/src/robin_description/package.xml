<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robin_description</name>
  <version>0.0.1</version>
  <description>Shared URDF/xacro description and meshes for the ROBIN welding cell
    (UR10e + Fronius weld torch + Garmo laser profilometer + welding table). Pure,
    hardware-agnostic description rendered by the no-hardware demo; contains no driver
    code.</description>
  <maintainer email="daniel.haas@3d-components.co">Daniel Haas</maintainer>
  <maintainer email="virgilio.gomez@3d-components.co">Virgilio Gomez</maintainer>
  <maintainer email="jayant@mil-as.no">Jayant Singh</maintainer>
  <license>AGPL-3.0-only</license>

  <exec_depend>xacro</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
