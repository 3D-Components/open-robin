# StartWeld.srv - Start welding with parameters
#
# Synergetic mode only: wire feed speed (WFS) is the sole command.
# Current and voltage are determined by the Fronius power source.

float32 wire_speed                # Wire feed speed in m/min
float32 arc_length_correction_mm  # Arc length correction in mm (clamped to [-10, 10])
float32 weld_speed                # Travel speed in m/s (forwarded to WAGO PLC)
---
# Response: success status
bool success
string message
