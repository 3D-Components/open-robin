<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fronius">

  <!-- Define Fronius macro -->
    <xacro:macro name="fronius_weld_torch" params="parent sim:=false ctwd:=0.015 tip_x:=0.00 tip_y:=-0.095 tip_z:=0.63 tip_roll:=${-pi/6} tip_pitch:=0 tip_yaw:=0 *origin">

        <link name="weld_torch">
        <visual>
            <geometry>
                <mesh filename="package://robin_hardware_fronius/meshes/weld_torch/visual/weld_torch.obj"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robin_hardware_fronius/meshes/weld_torch/collision/weld_torch.stl"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="4.0"/>
            <origin xyz="0.016 -0.12 0.16" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
        </link>

        <!-- Contact tip: where the wire exits the torch nozzle (red sphere) -->
        <link name="contact_tip">
        <visual>
            <geometry>
                <sphere radius="0.005"/>
            </geometry>
            <material name="red">
            <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
        </link>

        <joint name="contact_tip_joint" type="fixed">
        <parent link="weld_torch"/>
        <child link="contact_tip"/>
        <!-- Contact tip position relative to torch mesh origin (configurable via xacro args) -->
        <origin xyz="${tip_x} ${tip_y} ${tip_z}" rpy="${tip_roll} ${tip_pitch} ${tip_yaw}"/>
        </joint>

        <!-- Wire tip (actual TCP) - offset from contact tip by CTWD along wire direction (local Z) -->
        <link name="wire_tip">
        <visual>
            <!-- Wire cylinder: 1mm diameter, 50mm long, extending behind wire_tip -->
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0005" length="0.05"/>
            </geometry>
            <material name="wire_silver">
                <color rgba="0.75 0.75 0.75 1"/>
            </material>
        </visual>
        <!-- Keep existing small sphere at tip -->
        <visual>
            <geometry>
                <sphere radius="0.002"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.003"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
        </inertial>
        </link>

        <joint name="wire_tip_joint" type="fixed">
            <parent link="contact_tip"/>
            <child link="wire_tip"/>
            <origin xyz="0 0 ${ctwd}" rpy="0 0 0"/>
        </joint>

        <!-- Prevent Gazebo fixed-joint lumping so wire_tip survives as a link -->
        <gazebo reference="wire_tip_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>

        <!-- Load Gazebo bead deposition plugin in sim mode -->
        <xacro:if value="${sim}">
        <gazebo>
            <plugin filename="robin_sim_plugin" name="robin_sim_gz::RobinSimPlugin">
                <weld_active_topic>/robin/weld_active</weld_active_topic>
            </plugin>
        </gazebo>
        </xacro:if>

        <joint name="weld_torch_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="weld_torch"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>
    </xacro:macro>
</robot>