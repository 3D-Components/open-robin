<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robin_moveit_config</name>
  <version>0.0.0</version>
  <description>MoveIt configuration for ROBIN welding robot (UR10e + Fronius torch + Garmo sensor)</description>
  <maintainer email="daniel.haas@3d-components.co">Daniel Haas</maintainer>
  <maintainer email="virgilio.gomez@3d-components.co">Virgilio Gomez</maintainer>
  <maintainer email="jayant@mil-as.no">Jayant Singh</maintainer>
  <license>AGPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- MoveIt core -->
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_kinematics</depend>
  <depend>moveit_configs_utils</depend>

  <!-- Pilz industrial motion planner -->
  <depend>pilz_industrial_motion_planner</depend>

  <!-- Robot description -->
  <exec_depend>robin_bringup</exec_depend>

  <!-- Controller interface -->
  <depend>controller_manager</depend>
  <depend>joint_trajectory_controller</depend>

  <!-- MoveIt Servo for Cartesian jogging -->
  <exec_depend>moveit_servo</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
