<launch>
  <arg name="default_ctwd" default="0.015"/>
  <arg name="ctwd_file" default=""/>
  <arg name="use_sim" default="false"/>
  <node pkg="robin_core" exec="tcp_manager_node" name="tcp_manager_node" output="screen">
    <param name="default_ctwd" value="$(var default_ctwd)"/>
    <param name="default_mode" value="welding"/>
    <param name="ctwd_file" value="$(var ctwd_file)"/>
    <param name="use_sim_time" value="$(var use_sim)"/>
  </node>
</launch>