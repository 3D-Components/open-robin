# Optional local environment template for ROBIN Compose runs.
# Copy to .env only when you need to override the defaults.

# Select the active domain profile. The reviewer hello world uses welding because
# the bundled model input feature names are defined by the welding profile.
ROBIN_PROFILE=welding

# API container to Orion-LD URL. The default works for the Docker Compose stack.
ORION_URL=http://orion-ld:1026

# The following variables are only relevant for ROS 2/Vulcanexus or full
# Linux demonstrator runs. They are not required by the no-hardware reviewer
# hello world.
UID=1000
GID=1000
DISPLAY=:0
